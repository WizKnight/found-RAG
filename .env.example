APP_NAME=Evidence Grounded Hybrid RAG
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

#API
API_HOST=127.0.0.1
API_PORT=8000

#LLM
LLM_PROVIDER=openai
LLM_MODEL=
OPENAI_API_KEY=

#Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

#Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

#Retrieval
DENSE_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=30
RERANK_TOP_K=8

CHUNK_SIZE=600
CHUNK_OVERLAP=100